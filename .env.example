# =============================================================================
# VTR-Agent — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=VTR-Agent
APP_VERSION=0.1.0
DEMO_MODE=true          # Set false in production
DEBUG=false             # Set true for verbose SQLAlchemy logging etc.

# ---------------------------------------------------------------------------
# Security (JWT)
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=3600     # seconds

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (development / demo)
DATABASE_URL=sqlite:///./vtr_agent.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vtr_agent

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# LLM Provider (Phase 2)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq          # groq | openrouter | openai | local
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
OPENAI_API_KEY=your-openai-key-here

# Model to use for planning & reasoning
LLM_MODEL=llama-3.3-70b-versatile    # Groq model name
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Retrieval / Vector Store (Phase 3)
# ---------------------------------------------------------------------------
VECTOR_STORE=chromadb       # chromadb | pinecone | qdrant
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinecone (if used)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1

# ---------------------------------------------------------------------------
# Sandbox (Phase 4)
# ---------------------------------------------------------------------------
SANDBOX_BASE_DIR=./data/sandboxes
SANDBOX_DEFAULT_TIMEOUT=30     # seconds
SANDBOX_DEFAULT_MEMORY_MB=256

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json     # json | console
ENABLE_METRICS=true
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
